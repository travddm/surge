{
	"version": "0.2",
	"import": ["./cspell.shared.json"],
	"files": [
		".git/COMMIT_EDITMSG",
		"*.{md,txt,yaml,yml}",
		"docs/**/*.{md,txt,yaml,yml}",
		".github/**/*.{md,yaml,yml}",
		"LICENSE"
	],
	"useGitignore": true,
	"cache": {
		"useCache": true,
		"cacheLocation": "node_modules/.cache/cspell/.cspellcache",
		"cacheStrategy": "content"
	},
	"ignorePaths": [
		".gitignore",
		".vscode/**",
		"*.log",
		"**/.git/!(COMMIT_EDITMSG)",
		"**/.git/!(COMMIT_EDITMSG)/**",
		"/package.json",
		"surge/**",
		"rbxts-transformer-surge/**"
	]
}
