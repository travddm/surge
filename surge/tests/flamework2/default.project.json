{
	"name": "surge-tests-flamework2",
	"globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
	"tree": {
		"$className": "DataModel",
		"ServerStorage": {
			"codecs": {
				"$path": "out"
			}
		},
		"ReplicatedStorage": {
			"rbxts_include": {
				"$className": "Folder",
				"$path": "include",
				"node_modules": {
					"$className": "Folder",
					"@rbxts": {
						"$path": "node_modules/@rbxts"
					},
					"@flamework-experimental": {
						"$path": "node_modules/@flamework-experimental"
					}
				}
			}
		}
	}
}
