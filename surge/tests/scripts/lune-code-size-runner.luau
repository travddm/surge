-- The code-size tier (section 11 of docs/specs/benchmark-harness.md): writes
-- ../../docs/benchmarks/code-size.md from the Luau bytecode each codec module of the benchmark
-- compiles to, via `mise run bench:code`. It runs under Lune because the figure is deterministic
-- for a pinned Lune: it is the length of what `luau.compile` returns, which no timing touches.
--
-- It reads compiled files and requires none, so it needs no Roblox shim. Each module under
-- out/bench/codecs/<fixture>/ holds one factory call (tests/src/bench/codecs/), so its bytecode is
-- one library's code for one shape, plus the few lines every such module carries to import the
-- factory. A `shapes` module holds types only and is skipped.
--
-- Like size.md, the table carries no date, machine or commit. Unlike it, the numbers depend on
-- the Luau compiler, so the file names the Lune version that produced them.
local fs = require("@lune/fs")
local luau = require("@lune/luau")
local process = require("@lune/process")

local CODECS_DIRECTORY = "out/bench/codecs"
local OUTPUT_PATH = "../../docs/benchmarks/code-size.md"
local LIBRARIES = { "surge", "fbs", "serio", "flamework2" }
local BASELINE = "surge"
local EMPTY = "—"
-- The level a published place compiles at, which the modules' own `--!optimize 2` asks for as
-- well, and the debug level that keeps line numbers and drops local names, as a live game does.
local COMPILE_OPTIONS = { optimizationLevel = 2, debugLevel = 1, coverageLevel = 0 }
-- Modules that hold every row of a column at once, so no row of the table can show them.
local WHOLE_MODULES = {
	{ "baseline", "out/bench/baseline/codecs.luau" },
	{ "blink", "out/bench/blink/server.luau" },
	{ "zap", "out/bench/zap/server.luau" },
}

if #process.args > 0 then
	error(("unexpected argument %q: the code-size tier takes none"):format(process.args[1]))
end

local function bytecodeBytes(path)
	return #luau.compile(fs.readFile(path), COMPILE_OPTIONS)
end

-- `surge-packed.luau` is surge's module for the fixture's `packed` variant, and `surge.luau` for
-- its only one.
local function parse(fileName)
	local stem = fileName:match("^(.+)%.luau$")
	if not stem or stem == "shapes" then
		return nil
	end
	for _, library in LIBRARIES do
		if stem == library then
			return library, ""
		end
		local variant = stem:match("^" .. library .. "%-(.+)$")
		if variant then
			return library, variant
		end
	end
	error(("%s: not a codec module of %s"):format(fileName, table.concat(LIBRARIES, ", ")))
end

local rows = {}
local fixtures = fs.readDir(CODECS_DIRECTORY)
table.sort(fixtures)
for _, fixture in fixtures do
	local byVariant = {}
	local variants = {}
	local files = fs.readDir(CODECS_DIRECTORY .. "/" .. fixture)
	table.sort(files)
	for _, fileName in files do
		local library, variant = parse(fileName)
		if library then
			if not byVariant[variant] then
				byVariant[variant] = {}
				table.insert(variants, variant)
			end
			byVariant[variant][library] = bytecodeBytes(("%s/%s/%s"):format(CODECS_DIRECTORY, fixture, fileName))
		end
	end
	table.sort(variants)
	for _, variant in variants do
		local name = if variant == "" then fixture else ("%s (%s)"):format(fixture, variant)
		table.insert(rows, { name = name, cells = byVariant[variant] })
	end
end
if #rows == 0 then
	error("no codec module under " .. CODECS_DIRECTORY .. ": compile tests/ first")
end

local lines = {}
local function paragraph(...)
	for _, line in { ... } do
		table.insert(lines, line)
	end
	table.insert(lines, "")
end

paragraph("# Benchmark results: bytes of code")

paragraph("Generated by `mise run bench:code`; do not edit by hand.")

paragraph(
	"Each cell is the Luau bytecode, in bytes, of the module that holds one",
	"library's serializer for one shape, with its ratio against surge. surge's",
	"module holds the code the transformer generates for the shape. fbs's and",
	"serio's hold the schema their transformer generates and one call: the code",
	"that reads the schema is in the library, and is the same for every shape.",
	"flamework2's holds the code Flamework 2's transformer generates for the shape,",
	"with the varint helpers and lookup tables it declares in each module."
)

paragraph(
	"Every module also carries the few lines that import its factory. The bytecode",
	("is what Lune %s's `luau.compile` returns at optimization level %d and debug"):format(
		_VERSION:match("%d+%.%d+%.%d+") or _VERSION,
		COMPILE_OPTIONS.optimizationLevel
	),
	("level %d; another compiler version can give another count."):format(COMPILE_OPTIONS.debugLevel)
)

local header = { "Module" }
local separator = { "---" }
for _, library in LIBRARIES do
	table.insert(header, library)
	table.insert(separator, "---")
end
table.insert(lines, "| " .. table.concat(header, " | ") .. " |")
table.insert(lines, "| " .. table.concat(separator, " | ") .. " |")
for _, row in rows do
	local baseline = row.cells[BASELINE]
	if not baseline then
		error(("%s: no %s module"):format(row.name, BASELINE))
	end
	local columns = { row.name }
	for _, library in LIBRARIES do
		local bytes = row.cells[library]
		if not bytes then
			table.insert(columns, EMPTY)
		elseif library == BASELINE then
			table.insert(columns, tostring(bytes))
		else
			table.insert(columns, ("%d (%.2f×)"):format(bytes, bytes / baseline))
		end
	end
	table.insert(lines, "| " .. table.concat(columns, " | ") .. " |")
end
table.insert(lines, "")

paragraph(
	"The hand-written baseline, Blink and Zap each hold every row they cover in",
	"one module, so they have no cell above:"
)

table.insert(lines, "| Column | Module | Bytes |")
table.insert(lines, "| --- | --- | --- |")
for _, entry in WHOLE_MODULES do
	local column, path = entry[1], entry[2]
	local source = path:gsub("^out/", "src/")
	table.insert(lines, ("| %s | `tests/%s` | %d |"):format(column, source, bytecodeBytes(path)))
end
table.insert(lines, "")

fs.writeFile(OUTPUT_PATH, table.concat(lines, "\n"))
print(("wrote %s: %d modules"):format(OUTPUT_PATH, #rows))
