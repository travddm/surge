// The files here are Lune scripts, but luau-lsp analyses this workspace as a Roblox project
// against a Rojo sourcemap (see .vscode/settings.json), so without this config it reports errors
// in files that run correctly.
{
	// Resolves `require("@lune/fs")` and friends against the type definitions that `lune setup`
	// writes. Devs need to have run it once; mise only installs the binary. The version must
	// track the `github:lune-org/lune` pin in mise.toml -- a stale path silently restores the
	// "Unknown require" errors this exists to fix.
	"aliases": {
		"lune": "~/.lune/.typedefs/0.10.5/"
	},

	// lune-roblox-shim.luau swaps `script` around each require so the compiled output's
	// `TS.import` calls resolve against the fake Instance tree.
	"globals": ["script"],

	// Overwriting `require`, `script`, and `game` is the whole mechanism by which compiled
	// Roblox output runs outside Roblox, so the warning has nothing to say here.
	"lint": { "BuiltinGlobalWrite": false }
}
