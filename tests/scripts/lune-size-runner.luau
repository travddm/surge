-- The size tier (section 5 of docs/specs/benchmark-harness.md): writes ../docs/benchmarks/size.md from the
-- bytes each fixture costs under each library, via `mise run bench:size`. It runs under Lune
-- because a byte count is deterministic -- unlike a timing, which only the real engine can give
-- (see section 6 of docs/specs/benchmark-harness.md), and which `mise run bench:speed` collects
-- instead.
--
-- It requires src/bench/size.luau directly rather than an entry point in src/index.ts, so a
-- broken fixture can never fail the round-trip suite that index.ts's `main` runs.
--
-- `--only <pattern>...` measures just the fixtures those patterns select and prints the table
-- instead, for reading one change without a full run; see the flag below.
--
-- The generated table carries no date, machine, or commit: the numbers are byte counts, so the
-- file changes only when an encoding changes, which makes it a byte-regression gate as well as
-- a result. `mise run bench:size` reformats it with Prettier afterwards, since every checked-in
-- Markdown file has to pass `mise run format:check`.
local fs = require("@lune/fs")
local process = require("@lune/process")
local shim = require("./lune-roblox-shim")

local OUTPUT_DIRECTORY = "../docs/benchmarks"
local OUTPUT_PATH = OUTPUT_DIRECTORY .. "/size.md"
local BASELINE = "surge"
-- What a column reads where that library cannot express the row.
local EMPTY = "—"

-- `--only <pattern>...` measures just the fixtures those patterns select (see
-- src/bench/selection.ts) and prints the table instead of writing size.md, which is how a change
-- to one encoding is read without a full run. The flag is required rather than inferred from
-- "there are arguments", so that `bench:size:only` with no pattern stops instead of quietly
-- rewriting the file with the whole catalog under a task name that says otherwise.
local SCOPE_FLAG = "--only"

local patterns = {}
local scoped = process.args[1] == SCOPE_FLAG
if scoped then
	table.move(process.args, 2, #process.args, 1, patterns)
	if #patterns == 0 then
		error(SCOPE_FLAG .. " needs at least one fixture pattern")
	end
elseif #process.args > 0 then
	error(("unexpected argument %q (a scoped run is `%s <pattern>...`)"):format(process.args[1], SCOPE_FLAG))
end

local bench = shim.tests:WaitForChild("bench")
local result = shim.requireInstance(bench:WaitForChild("size")).collectSizeRows(patterns)
local libraries, rows = result.libraries, result.rows

-- A marker no cell carries needs no explanation, so the paragraph describing the side channel is
-- written only when some library passes a value outside its buffer on some row.
local sideChannelUsed = false
for _, row in rows do
	for _, cell in row.cells do
		if cell.side > 0 then
			sideChannelUsed = true
		end
	end
end

local lines = {}

-- One paragraph, followed by the blank line Markdown needs after it.
local function paragraph(...)
	for _, line in { ... } do
		table.insert(lines, line)
	end
	table.insert(lines, "")
end

paragraph("# Benchmark results: bytes per value")

paragraph("Generated by `mise run bench:size`; do not edit by hand.")

paragraph(
	"Each cell is the serialized size of one sample value of the shape, in bytes,",
	"with its ratio against surge; every library encodes the same value. An empty",
	"cell means the library cannot express the row."
)

if sideChannelUsed then
	paragraph(
		"`+N side` means N values travel outside the buffer (the blob array in surge,",
		"fbs, and serio; the instance table in Zap), which costs bandwidth the byte",
		"count does not show."
	)
end

paragraph(
	"`Round trip` names each library whose decoded value differs from the input,",
	"with the largest difference in any component. About 1e-7 is f32 rounding of",
	"a `CFrame` rotation; a larger figure is quantization on purpose."
)

paragraph(
	"Blink and Zap are smaller than surge only where a length prefix appears:",
	"they default to a u16 count where surge writes u32, and `DataType.Length`",
	"narrows surge's."
)

paragraph(
	"`baseline` is a hand-written codec that writes surge's exact bytes on three",
	"rows; it exists for the speed table. Zap's bytes are one fired event minus",
	"its event-id byte."
)

local tableLines = {}
local header = { "Fixture" }
local separator = { "---" }
for _, library in libraries do
	table.insert(header, library)
	table.insert(separator, "---")
end
for _, column in { "Round trip", "What the row measures" } do
	table.insert(header, column)
	table.insert(separator, "---")
end
table.insert(tableLines, "| " .. table.concat(header, " | ") .. " |")
table.insert(tableLines, "| " .. table.concat(separator, " | ") .. " |")

-- nil where the library has no adapter for that row: its column is empty there.
local function cellOf(row, library)
	for _, cell in row.cells do
		if cell.library == library then
			return cell
		end
	end
	return nil
end

for _, row in rows do
	local baselineCell = cellOf(row, BASELINE)
	if not baselineCell then
		error(("%s: no %s cell"):format(row.name, BASELINE))
	end
	local baseline = baselineCell.bytes
	local columns = { row.name }
	local inexact = {}

	for _, library in libraries do
		local cell = cellOf(row, library)
		if not cell then
			table.insert(columns, EMPTY)
			continue
		end

		local text = tostring(cell.bytes)
		if library ~= BASELINE then
			text ..= (" (%.2f×)"):format(cell.bytes / baseline)
		end
		if cell.side > 0 then
			text ..= (" +%d side"):format(cell.side)
		end
		table.insert(columns, text)

		if cell.roundTrip ~= "exact" then
			-- -1 is size.ts's stand-in for "no number describes this difference".
			table.insert(inexact, if cell.maxError < 0 then library else ("%s %.0e"):format(library, cell.maxError))
		end
	end

	table.insert(columns, if #inexact == 0 then "exact" else "inexact: " .. table.concat(inexact, ", "))
	table.insert(columns, row.note)
	table.insert(tableLines, "| " .. table.concat(columns, " | ") .. " |")
end

if scoped then
	-- Printed, never written: the prose above describes the whole catalog, and a size.md holding
	-- a few of its rows would read as a result about all of them.
	print(
		("scoped to %d %s by %s; %s was not rewritten"):format(
			#rows,
			if #rows == 1 then "fixture" else "fixtures",
			table.concat(patterns, ", "),
			OUTPUT_PATH
		)
	)
	print(table.concat(tableLines, "\n"))
	return
end

table.move(tableLines, 1, #tableLines, #lines + 1, lines)

if not fs.isDir(OUTPUT_DIRECTORY) then
	fs.writeDir(OUTPUT_DIRECTORY)
end
fs.writeFile(OUTPUT_PATH, table.concat(lines, "\n") .. "\n")

print(("wrote %s (%d fixtures × %d libraries)"):format(OUTPUT_PATH, #rows, #libraries))
