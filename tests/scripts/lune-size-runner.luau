-- Tier 1 of docs/future-work/benchmark-tooling.md: writes ../docs/benchmarks/size.md from the
-- bytes each fixture costs, via `mise run bench:size`. It runs under Lune because a byte count
-- is deterministic -- unlike a timing, which only the real engine can give (see the Benchmarking
-- strategy in docs/testing.md), and which `mise run bench:speed` collects instead.
--
-- It requires src/bench/size.luau directly rather than an entry point in src/index.ts, so a
-- broken fixture can never fail the round-trip suite that index.ts's `main` runs.
--
-- The generated table carries no date, machine, or commit: the numbers are byte counts, so the
-- file changes only when an encoding changes, which makes it a byte-regression gate as well as
-- a result. `mise run bench:size` reformats it with Prettier afterwards, since every checked-in
-- Markdown file has to pass `mise run format:check`.
local fs = require("@lune/fs")
local shim = require("./lune-roblox-shim")

local OUTPUT_DIRECTORY = "../docs/benchmarks"
local OUTPUT_PATH = OUTPUT_DIRECTORY .. "/size.md"

local bench = shim.tests:WaitForChild("bench")
local rows = shim.requireInstance(bench:WaitForChild("size")).collectSizeRows()

local lines = {
	"# Benchmark results: bytes per value",
	"",
	"Generated by `mise run bench:size`; do not edit by hand. Tier 1 of the",
	"harness in [future-work/benchmark-tooling.md](../future-work/benchmark-tooling.md).",
	"",
	"`Bytes` is the serialized buffer for one sample value of the shape. `Side`",
	"is the number of values passed outside that buffer (surge's blob array),",
	"which cost bandwidth the buffer does not show. `Round trip` is `inexact`",
	"where the decoded value differs from the input at all: surge stores a",
	"`CFrame` rotation as an axis-angle triple, which is exact only for the 24",
	"axis-aligned rotations.",
	"",
	"Only surge has an adapter so far, so there is one column per metric and no",
	"ratio. fbs, serio, Blink, and Zap each add their own columns over these same",
	"fixtures.",
	"",
	"| Fixture | Bytes | Side | Round trip | What the row measures |",
	"| --- | --- | --- | --- | --- |",
}

for _, row in rows do
	table.insert(
		lines,
		("| %s | %d | %d | %s | %s |"):format(row.name, row.bytes, row.side, row.roundTrip, row.note)
	)
end

if not fs.isDir(OUTPUT_DIRECTORY) then
	fs.writeDir(OUTPUT_DIRECTORY)
end
fs.writeFile(OUTPUT_PATH, table.concat(lines, "\n") .. "\n")

print(("wrote %s (%d fixtures)"):format(OUTPUT_PATH, #rows))
