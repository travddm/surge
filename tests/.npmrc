# Pack-and-copy `file:` dependencies instead of symlinking them.
#
# Without this, `@rbxts/surge`'s `file:..` dependency would symlink
# tests/node_modules/@rbxts/surge -> .. (the repo root, which itself
# contains tests/), a two-hop symlink cycle -- the same class of hang this
# project already hit once with npm workspace hoisting (see
# docs/architecture.md). It also means `npm install` here exercises each
# dependency's `files` list and `prepare` script exactly the way a real
# `github:`-installed consumer would, which is the point: this is the local
# stand-in for that install, not a dev convenience shortcut.
install-links = true
